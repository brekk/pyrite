import Fn from "Function"
import String from "String"



NON_WORD_AND_SPACES = "[\\W\\s]"
slug :: String -> String
export slug = pipe(
  String.trim,
  String.toLower,
  String.replace(NON_WORD_AND_SPACES, "-"),
)
NEWLINE = "\n"
export addNewline = mappend($, NEWLINE)
export ensureNewline = Fn.unless(String.endsWith(NEWLINE), addNewline)
