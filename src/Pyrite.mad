import FilePath from "FilePath"
import List from "List"
import Test from "Test"
import Wish from "Wish"

import Log from "@/Log"
import Snap from "@/Snapshot"
import _String from "@/String"



createSnapshotWithBaseAndTransformer :: (String -> String)
  -> String
  -> String
  -> ({} -> String)
  -> Snap.Snapshot
export createSnapshotWithBaseAndTransformer = (pathTransformer, basePath, key, camera) => pipe(
  _String.slug,
  List.append($, [basePath]),
  FilePath.joinPath,
  pathTransformer,
  Snap.create($, camera()),
  Log.env.processorDetail("snapshot"),
)(key)
export createRecorder = createSnapshotWithBaseAndTransformer(mappend($, ".golden.txt"))
snapshotAssertion = (bod, #[success, inner]) => do {
  return Test.assertEquals(bod, inner)
  // return Test.assertEquals(true, success)
}
_handleError :: String -> String -> Wish Snap.FoolsError a -> Wish Test.AssertionError a
export _handleError = (pth, bod, w) => Wish.mapRej(
  where {
    Snap.CannotWrite(p, actualBody) =>
      Test.AssertionError(bod, actualBody)

    Snap.CannotRead =>
      Test.ErrorWithMessage("Cannot read: " ++ pth)
  },
)(w)
export testSnapshot = (snap) => {
  pth = Snap.path(snap)
  bod = Snap.body(snap)
  return Test.test(
    "pyrite: " ++ pth,
    () => pipe(
      Log.env.test("processing snapshot"),
      Snap.resnap,
      _handleError(pth, bod),
      chain(snapshotAssertion(bod)),
    )(snap),
  )
}
// because it's fun to be fun!
export panhandle = createRecorder
export test = testSnapshot
