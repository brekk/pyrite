import FilePath from "FilePath"
import List from "List"
import Test from "Test"
import Wish from "Wish"

import Log from "@/Log"
import Snap from "@/Snapshot"
import _String from "@/String"



createSnapshotWithBaseAndTransformer :: (String -> String)
  -> String
  -> ({} -> String)
  -> String
  -> Snap.Snapshot
export createSnapshotWithBaseAndTransformer = (pathTransformer, basePath, camera, key) => pipe(
  _String.slug,
  List.append($, [basePath]),
  FilePath.joinPath,
  pathTransformer,
  Log.env.processorDetail("path processed"),
  Snap.create($, camera()),
  Log.env.processorDetail("snapshot"),
)(key)
export createRecorder = createSnapshotWithBaseAndTransformer(mappend($, ".golden.txt"))
export panhandle = createRecorder
doBoth = (bod, success, inner) => do {
  _ <- Test.assertEquals(bod, inner)
  return Test.assertEquals(true, success)
}
export testSnapshot = (snap) => {
  pth = Snap.path(snap)
  bod = Snap.body(snap)
  return Test.test(
    "pyrite: " ++ pth,
    () => pipe(
      Log.env.test("processing snapshot"),
      Snap.resnap,
      Wish.mapRej(
        where {
          Snap.CannotWrite(p, actualBody) =>
            Test.AssertionError(bod, actualBody)

          Snap.CannotRead =>
            Test.ErrorWithMessage("Cannot read: " ++ pth)
        },
      ),
      map(Log.env.test("why good")),
      Wish.mapRej(Log.env.test("why bad")),
      chain(where { #[success, inner] => doBoth(bod, success, inner) }),
    )(snap),
  )
}
