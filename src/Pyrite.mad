import type { Wish } from "Wish"

import FilePath from "FilePath"
import Fn from "Function"
import List from "List"
import Test from "Test"

import Exec from "study/Cli"

import Log from "@/Log"
import Snap from "@/Snapshot"
import _String from "@/String"



export type PanHandle = Unseen | Inspected(String)
export type Framed = Framed(PanHandle, Snap.Snapshot)
createSnapshotWithBaseAndTransformer :: (String -> String)
  -> String
  -> ({} -> String)
  -> String
  -> Snap.Snapshot
export createSnapshotWithBaseAndTransformer = (pathTransformer, basePath, camera, key) => pipe(
  _String.slug,
  List.append($, [basePath]),
  FilePath.joinPath,
  pathTransformer,
  Log.env.processorDetail("path processed"),
  Snap.create($, camera()),
  Log.env.processorDetail("snapshot"),
)(key)
export createRecorder = createSnapshotWithBaseAndTransformer(mappend($, ".golden.txt"))
export panhandle = createRecorder

