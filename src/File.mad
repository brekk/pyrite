import type { CommandResult } from "Process"

import Dir from "Directory"
import File from "File"
import Path from "FilePath"
import Fn from "Function"
import Wish from "Wish"

import Log from "@/Log"



writeFileWithRecursivePath :: Boolean -> String -> String -> Wish String String
export writeFileWithRecursivePath = (recursive, filePath, body) => pipe(
  Path.parentPath,
  Log.env.file("creating path..."),
  Dir.create($, { recursive }),
  Wish.mapRej(
    pipe(
      Log.env.file("Failed to create path!"),
      Fn.always("Unable to create directory"),
    ),
  ),
  chain(
    (_) => pipe(
      Log.env.file("Writing to path"),
      File.write(filePath),
      Wish.mapRej(
        pipe(
          Log.env.file("Failed to write file!"),
          Fn.always("Unable to write file"),
        ),
      ),
    )(body),
  ),
  map(Fn.always(body)),
)(filePath)
export writeFile = writeFileWithRecursivePath(true)
export exists = (p) => pipe(
  Log.env.file(`exists?`),
  File.exists,
  Wish.mapRej(Log.env.file("doesn't exist " ++ p)),
  Wish.chainRej(Fn.always(Wish.good(false))),
  map(Log.env.file("resolved? " ++ p)),
)(p)
