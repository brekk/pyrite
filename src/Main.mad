import IO from "IO"
import Wish from "Wish"

import Pyrite from "@/Pyrite"
import Snapshot from "@/Snapshot"



main = () => {
  pipe(
    Pyrite.createRecorder($, "record of note", () => "saved222!"),
    Snapshot.resnap,
    Wish.fulfill(
      pipe(
        show,
        IO.put,
      ),
      (raw) => {
        IO.pTrace("raw", raw)
      },
    ),
  )("./golden")
}
