import IO from "IO"
import Wish from "Wish"

import Log from "@/Log"
import Pyrite from "@/Pyrite"
import Snapshot from "@/Snapshot"



main = () => {
  pipe(
    Pyrite.createRecorder($, () => "saved222!", "record of note"),
    Snapshot.resnap,
    Wish.fulfill(
      pipe(
        show,
        IO.put,
      ),
      (raw) => {
        Log.env.processor("raw", raw)
      },
    ),
  )("./golden")
}
