import File from "File"
import FilePath from "FilePath"
import Fn from "Function"
import Monad from "Monad"
import String from "String"
import Test from "Test"
import Wish from "Wish"

import Study from "Study"

import _File from "@/File"
import Log from "@/Log"



export type Snapshot = Snapshot(String, String)
export create = Snapshot
path :: Snapshot -> String
export path = where {
  Snapshot(p, _) =>
    p
}
body :: Snapshot -> String
export body = where {
  Snapshot(_, b) =>
    b
}
setPath :: String -> Snapshot -> Snapshot
export setPath = (p, sn) => where(sn) {
  Snapshot(_, x) =>
    Snapshot(p, x)
}
setBody :: String -> Snapshot -> Snapshot
export setBody = (b, sn) => where(sn) {
  Snapshot(p, _) =>
    Snapshot(p, b)
}
// binary function application
modbod :: (String -> String -> a) -> String -> Snapshot -> a
modbod = (fn, x, y) => pipe(
  body,
  fn(x),
)(y)
equals :: String -> Snapshot -> Boolean
export equals = modbod(Fn.equals)
type FoolsError = CannotWrite(String, String) | CannotRead
ofPair = (a, b) => #[a, b]
toFile :: Snapshot -> Wish FoolsError #[Boolean, String]
export toFile = where {
  Snapshot(p, b) =>
    pipe(
      _File.writeFile($, b),
      map(Fn.always(#[true, b])),
      Wish.mapRej(Fn.always(CannotWrite(p, b))),
    )(p)
}
addTrailingNewline = mappend($, "\n")
sourceOfFileMatchesSnap = (bod, snap) => pipe(
  path,
  File.read,
  Wish.mapRej(Fn.always(CannotRead)),
  map(
    // we have to test for the case where there's a trailing newline
    (v) => pipe(
      addTrailingNewline,
      Fn.equals(bod),
      ofPair($, v),
    )(v),
  ),
)(snap)
isConcrete = pipe(
  path,
  Log.env.snapshotDetail("checking path..."),
  _File.exists,
  map(Log.env.snapshotDetail("path exists?")),
)
checkCorrect :: Snapshot -> Wish FoolsError #[Boolean, String]
checkCorrect = (snap) => {
  bod = body(snap)
  return pipe(
    sourceOfFileMatchesSnap(bod),
  )(snap)
}
// the core functionality of our module
resnap :: Snapshot -> Wish FoolsError #[Boolean, String]
export resnap = (snap) => do {
  exists <- isConcrete(snap)
  return if (!exists) {
    toFile(snap)
  } else {
    checkCorrect(snap)
  }
}
doBoth = (bod, success, inner) => do {
  _ <- Test.assertEquals(bod, inner)
  return Test.assertEquals(true, success)
}
export testSnapshot = (snap) => {
  pth = path(snap)
  bod = body(snap)
  return Test.test(
    "pyrite: " ++ pth,
    () => pipe(
      Log.env.test("processing snapshot"),
      resnap,
      Wish.mapRej(
        where {
          CannotWrite(p, actualBody) =>
            Test.AssertionError(bod, actualBody)

          CannotRead =>
            Test.ErrorWithMessage("Cannot read: " ++ pth)
        },
      ),
      map(Log.env.test("why good")),
      Wish.mapRej(Log.env.test("why bad")),
      chain(where { #[success, inner] => doBoth(bod, success, inner) }),
    )(snap),
  )
}
