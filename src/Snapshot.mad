import File from "File"
import FilePath from "FilePath"
import Fn from "Function"
import Monad from "Monad"
import String from "String"
import Test from "Test"
import Wish from "Wish"

import Study from "Study"

import _File from "@/File"
import Log from "@/Log"



export type Snapshot = Snapshot(String, String)
export create = Snapshot
path :: Snapshot -> String
export path = where {
  Snapshot(p, _) =>
    p
}
body :: Snapshot -> String
export body = where {
  Snapshot(_, b) =>
    b
}
setPath :: String -> Snapshot -> Snapshot
export setPath = (p, sn) => where(sn) {
  Snapshot(_, x) =>
    Snapshot(p, x)
}
setBody :: String -> Snapshot -> Snapshot
export setBody = (b, sn) => where(sn) {
  Snapshot(p, _) =>
    Snapshot(p, b)
}
// binary function application
modbod :: (String -> String -> a) -> String -> Snapshot -> a
modbod = (fn, x, y) => pipe(
  body,
  fn(x),
)(y)
equals :: String -> Snapshot -> Boolean
export equals = modbod(Fn.equals)
type FoolsError = CannotWrite | CannotRead
toFile :: Snapshot -> Wish FoolsError Boolean
export toFile = pipe(
  Log.env.snapshot("toFile outer"),
  where {
    Snapshot(p, b) =>
      pipe(
        Log.env.snapshot("toFile"),
        _File.writeFile($, b),
        map(
          pipe(
            Fn.always(true),
            Log.env.snapshotGood("matched"),
          ),
        ),
        Wish.mapRej(
          pipe(
            Log.env.snapshotBad("failed to write"),
            Fn.always(CannotWrite),
          ),
        ),
      )(p)
  },
)
sourceOfFileMatchesSnap = (bod, snap) => pipe(
  path,
  File.read,
  Wish.mapRej(Fn.always(CannotRead)),
  map(
    Fn.either(
      // we have to test for the case where there's a trailing newline
      pipe(
        mappend($, "\n"),
        Fn.equals(bod),
      ),
      Fn.equals(bod),
    ),
  ),
)(snap)
isConcrete = pipe(
  path,
  Log.env.snapshotDetail("checking path..."),
  _File.exists,
  map(Log.env.snapshotDetail("path exists?")),
)
checkCorrect :: Snapshot -> Wish FoolsError Boolean
checkCorrect = (snap) => pipe(
  sourceOfFileMatchesSnap(body(snap)),
)(snap)
// the core functionality of our module
resnap :: Snapshot -> Wish FoolsError Boolean
export resnap = (snap) => do {
  exists <- isConcrete(snap)
  return if (!exists) {
    pipe(
      toFile,
      Log.env.snapshot("doesn't exist, toFile it"),
    )(snap)
  } else {
    checkCorrect(snap)
  }
}
export testSnapshot = (snap) => {
  return Test.test(
    "pyrite: " ++ path(snap) ++ " does not match snapshot",
    () => do {
      snapshotValid <- pipe(
        Log.env.test("processing snapshot"),
        resnap,
        Wish.mapRej(
          pipe(
            Log.env.snapshotBad("post resnap, eat your heart out thanos"),
            Fn.always(Test.ErrorWithMessage("Unable to load snapshot")),
          ),
        ),
      )(snap)
      return Test.assertEquals(true, snapshotValid)
    },
  )
}
