import File from "File"
import FilePath from "FilePath"
import Fn from "Function"
import Monad from "Monad"
import String from "String"
import Wish from "Wish"

import _File from "@/File"
import Log from "@/Log"



type Existence = NotYetReal | Real(String)
export type Snapshot = Snapshot(String, String)
export create = Snapshot
path :: Snapshot -> String
export path = where {
  Snapshot(p, _) =>
    p
}
body :: Snapshot -> String
export body = where {
  Snapshot(_, b) =>
    b
}
setPath :: String -> Snapshot -> Snapshot
export setPath = (p, sn) => where(sn) {
  Snapshot(_, x) =>
    Snapshot(p, x)
}
setBody :: String -> Snapshot -> Snapshot
export setBody = (b, sn) => where(sn) {
  Snapshot(p, _) =>
    Snapshot(p, b)
}
// binary function application
modbod :: (String -> String -> a) -> String -> Snapshot -> a
modbod = (fn, x, y) => pipe(
  body,
  fn(x),
)(y)
equals :: String -> Snapshot -> Boolean
export equals = modbod(Fn.equals)
type FoolsError = CannotWrite | CannotRead
toFile :: Snapshot -> Wish FoolsError Boolean
export toFile = where {
  Snapshot(p, b) =>
    pipe(
      Log.env.snapshot("toFile: writing to path"),
      _File.writeFile($, b),
      map(Fn.always(true)),
      map(Log.env.snapshotGood("hooray")),
      Wish.mapRej(
        pipe(
          Log.env.snapshotBad("fail to write"),
          Fn.always(CannotWrite),
        ),
      ),
    )(p)
}
// export toFile = toFileWithPathing(Fn.identity)
fileEquals :: String -> Snapshot -> Wish FoolsError Boolean
export fileEquals = (bod, snap) => pipe(
  path,
  _File.exists,
  map(Log.env.snapshotGood("exists?")),
  chain(
    (yes) => yes
      ? pipe(
        path,
        File.read,
        Wish.mapRej(Fn.always(CannotRead)),
        map(Fn.equals(bod)),
      )(snap)
      : Wish.good(false),
  ),
)(snap)
// the core functionality of our module
resnap :: Snapshot -> Wish FoolsError Boolean
export resnap = (snap) => do {
  exists <- _File.exists(path(snap))
  matches <- fileEquals(body(snap), snap)
  return if (!exists) {
    pipe(
      toFile,
      map(Log.env.snapshot("doesn't yet exist")),
    )(snap)
  } else {
    pipe(
      Log.env.snapshot("matches"),
      Wish.good,
      map(Log.env.snapshotGood("identical to the existing!")),
    )(matches)
  }
}
