import File from "File"
import Fn from "Function"
import String from "String"
import Wish from "Wish"

import _File from "@/File"
import Log from "@/Log"
import _String from "@/String"



// Snapshot(pathToEventualFile, body)
export type Snapshot = Snapshot(String, String)
export create = (p, b) => pipe(
  // File.write adds a trailing newline, so our snapshot does too
  _String.addNewline,
  Snapshot(p),
)(b)
path :: Snapshot -> String
export path = where {
  Snapshot(p, _) =>
    p
}
body :: Snapshot -> String
export body = where {
  Snapshot(_, b) =>
    b
}
setPath :: String -> Snapshot -> Snapshot
export setPath = (p, sn) => where(sn) {
  Snapshot(_, x) =>
    Snapshot(p, x)
}
setBody :: String -> Snapshot -> Snapshot
export setBody = (b, sn) => where(sn) {
  Snapshot(p, _) =>
    Snapshot(p, b)
}
// binary function application
modbod :: (String -> String -> a) -> String -> Snapshot -> a
modbod = (fn, x, y) => pipe(
  body,
  fn(x),
)(y)
equals :: String -> Snapshot -> Boolean
export equals = modbod(Fn.equals)
export type FoolsError = CannotWrite(String, String) | CannotRead
ofPair = (a, b) => #[a, b]
toFile :: Snapshot -> Wish FoolsError #[Boolean, String]
export toFile = where {
  Snapshot(p, b) =>
    pipe(
      _File.writeFile($, b),
      map(Fn.always(#[true, b])),
      Wish.mapRej(Fn.always(CannotWrite(p, b))),
    )(p)
}
sourceOfFileMatchesSnap :: String -> Snapshot -> Wish FoolsError #[Boolean, String]
export sourceOfFileMatchesSnap = (bod, snap) => pipe(
  path,
  File.read,
  Wish.mapRej(Fn.always(CannotRead)),
  map(
    (v) => pipe(
      Fn.equals(bod),
      ofPair($, v),
    )(v),
  ),
)(snap)
exists :: Snapshot -> Wish a Boolean
export exists = pipe(
  path,
  _File.exists,
)
checkCorrect :: Snapshot -> Wish FoolsError #[Boolean, String]
export checkCorrect = (snap) => {
  bod = body(snap)
  return pipe(
    sourceOfFileMatchesSnap(bod),
  )(snap)
}
// the core functionality of our module
// infinity gauntlet, thrown
resnap :: Snapshot -> Wish FoolsError #[Boolean, String]
export resnap = (snap) => do {
  e <- exists(snap)
  return if (!e) {
    toFile(snap)
  } else {
    checkCorrect(snap)
  }
}
