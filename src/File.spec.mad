import FilePath from "FilePath"
import Fn from "Function"
import IO from "IO"
import Process from "Process"
import Test from "Test"
import Wish from "Wish"

import _File from "@/File"



Test.test(
  "File.exists",
  () => do {
    _ <- pipe(
      _File.exists,
      chain(Test.assertEquals(true)),
    )("./madlib.json")
    check <- _File.exists("./invalid-file-should-not-load.biz")
    return Test.assertEquals(false, check)
  },
)
FIXTURE_FILE = "./test/temporary/nested/path/value.txt"
FIXTURE_PATH = FilePath.parentPath(FIXTURE_FILE)
// this doesn't appear to be something that we can change the outcome of
// so commenting out the non-recursive test for now
