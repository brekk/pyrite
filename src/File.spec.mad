Test.test(
  "writeFile",
  () => do {
    hooray <- pipe(
      _File.writeFile($, "This is a test value. This file shouldn't persist"),
      map(Fn.always(true)),
      Wish.chainRej(Fn.always(Wish.good(false))),
    )(FIXTURE_FILE)
    return Test.assertEquals(true, hooray)
  },
)
Test.test(
  "writeFile - bad path",
  () => do {
    hooray <- pipe(
      _File.writeFile($, "This is a test value. This file shouldn't persist"),
      map(Fn.always(true)),
      Wish.chainRej(Fn.always(Wish.good(false))),
    )("")
    return Test.assertEquals(false, hooray)
  },
)
// kill them files
afterAll = () => pipe(
  Process.exec("rm", ["-r", FIXTURE_PATH]),
  map(Fn.always({})),
)(Process.DEFAULT_COMMAND_OPTIONS)
